# Windows integration only; no game patches or generated code.
if(WIN32 AND NOT MINGW AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  get_filename_component(_clang_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  file(GLOB _builtins "${_clang_dir}/../lib/clang/*/lib/windows/clang_rt.builtins-x86_64.lib")
  list(LENGTH _builtins _count)
  if(_count EQUAL 1)
    target_link_libraries(saturn ${_builtins})
  else()
    message(FATAL_ERROR "Expected one Clang builtins library; found ${_count}")
  endif()
endif()
if(TARGET saturnkit_hw AND DEFINED SF3_GL_INCLUDE)
  target_include_directories(saturnkit_hw PRIVATE "${SF3_GL_INCLUDE}")
  target_compile_definitions(saturnkit_hw PRIVATE NOMINMAX)
endif()
if(SDL3_FOUND AND TARGET saturn_host)
  set(_sf3_input "${CMAKE_CURRENT_LIST_DIR}/../native")
  target_sources(saturn_host PRIVATE "${_sf3_input}/controllers.cpp" "${_sf3_input}/replay-checkpoint.cpp" "${_sf3_input}/gpu-renderer.cpp")
  if(SF3_PRECOMPILED_SHADERS)
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/shaders")
    foreach(_shader geometry hd-assets)
      foreach(_format dxil spv)
        configure_file("${SF3_PRECOMPILED_SHADERS}/${_shader}.${_format}" "${CMAKE_BINARY_DIR}/shaders/${_shader}.${_format}" COPYONLY)
      endforeach()
    endforeach()
    add_custom_target(hd_shaders)
    add_custom_target(geometry_shaders)
  else()
  find_program(SF3_DXC dxc HINTS "${CMAKE_CURRENT_LIST_DIR}/../.local/dxc-1.9.2609/bin/x64" REQUIRED)
  foreach(_format dxil spv)
    set(_shader_flags)
    if(_format STREQUAL "spv")
      set(_shader_flags -spirv -fspv-target-env=vulkan1.0)
    endif()
    add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/shaders/hd-assets.${_format}"
      COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/shaders"
      COMMAND "${SF3_DXC}" -T ps_6_0 -E main -O3 ${_shader_flags} "${_sf3_input}/hd-assets.hlsl" -Fo "${CMAKE_BINARY_DIR}/shaders/hd-assets.${_format}"
      DEPENDS "${_sf3_input}/hd-assets.hlsl" VERBATIM)
    add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/shaders/geometry.${_format}"
      COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/shaders"
      COMMAND "${SF3_DXC}" -T ps_6_0 -E main -O3 ${_shader_flags} "${_sf3_input}/geometry.hlsl" -Fo "${CMAKE_BINARY_DIR}/shaders/geometry.${_format}"
      DEPENDS "${_sf3_input}/geometry.hlsl" VERBATIM)
  endforeach()
  add_custom_target(hd_shaders DEPENDS "${CMAKE_BINARY_DIR}/shaders/hd-assets.dxil" "${CMAKE_BINARY_DIR}/shaders/hd-assets.spv")
  add_custom_target(geometry_shaders ALL DEPENDS "${CMAKE_BINARY_DIR}/shaders/geometry.dxil" "${CMAKE_BINARY_DIR}/shaders/geometry.spv")
  endif()
  add_dependencies(saturn geometry_shaders)
  add_executable(render_dump_gpu "${CMAKE_CURRENT_LIST_DIR}/tests/render-dump.cpp" "${SATURN_RUNTIME}/tests/no_modules.cpp" "${_sf3_input}/hd-gpu.cpp")
  target_compile_definitions(render_dump_gpu PRIVATE SF3_GPU_DIAGNOSTIC=1)
  target_include_directories(render_dump_gpu PRIVATE "${_sf3_input}")
  target_link_libraries(render_dump_gpu PRIVATE saturn_core saturn_machine SDL3::SDL3 saturn_host ${_builtins})
  add_dependencies(render_dump_gpu hd_shaders)
  target_include_directories(saturn_host PRIVATE "${_sf3_input}")
  target_compile_definitions(saturn_host PRIVATE SF3_CONTROLLER_SUPPORT=1)
  add_executable(controller_setup "${_sf3_input}/controller-setup.cpp" "${_sf3_input}/controllers.cpp")
  target_link_libraries(controller_setup PRIVATE SDL3::SDL3)
  add_executable(controller_selftest "${_sf3_input}/controller-selftest.cpp" "${_sf3_input}/controllers.cpp")
  target_link_libraries(controller_selftest PRIVATE SDL3::SDL3)
  add_executable(replay_checkpoint "${_sf3_input}/replay-checkpoint-cli.cpp" "${_sf3_input}/replay-checkpoint.cpp")
  add_executable(replay_ui_selftest "${CMAKE_CURRENT_LIST_DIR}/tests/replay-ui.cpp" "${SATURN_RUNTIME}/tests/no_modules.cpp")
  add_dependencies(replay_ui_selftest geometry_shaders)
  get_target_property(_sf3_host_sources saturn_host SOURCES)
  list(FILTER _sf3_host_sources EXCLUDE REGEX "/host/host\\.cpp$")
  get_target_property(_sf3_host_includes saturn_host INCLUDE_DIRECTORIES)
  target_sources(replay_ui_selftest PRIVATE ${_sf3_host_sources})
  target_compile_definitions(replay_ui_selftest PRIVATE SF3_CONTROLLER_SUPPORT=1 SF3_HOST_SOURCE="${SATURN_RUNTIME}/src/host/host.cpp")
  target_include_directories(replay_ui_selftest PRIVATE "${_sf3_input}" ${_sf3_host_includes})
  target_link_libraries(replay_ui_selftest PRIVATE saturn_core saturn_machine SDL3::SDL3 saturn_imgui ${_builtins})
  add_executable(gpu_renderer_selftest "${CMAKE_CURRENT_LIST_DIR}/tests/gpu-renderer.cpp" "${SATURN_RUNTIME}/tests/no_modules.cpp")
  target_include_directories(gpu_renderer_selftest PRIVATE "${_sf3_input}")
  target_link_libraries(gpu_renderer_selftest PRIVATE saturn_core saturn_machine saturn_host SDL3::SDL3 ${_builtins})
  add_dependencies(gpu_renderer_selftest geometry_shaders)
endif()
if(WIN32)
  enable_language(RC)
  set(_sf3_manifest_dir "${CMAKE_CURRENT_LIST_DIR}/../native")
  set_source_files_properties("${_sf3_manifest_dir}/windows.rc" PROPERTIES OBJECT_DEPENDS "${_sf3_manifest_dir}/app.manifest")
  foreach(_target saturn controller_setup controller_selftest replay_checkpoint replay_ui_selftest gpu_renderer_selftest render_dump_gpu)
    if(TARGET ${_target})
      target_sources(${_target} PRIVATE "${_sf3_manifest_dir}/windows.rc")
      target_include_directories(${_target} PRIVATE "${_sf3_manifest_dir}")
    endif()
  endforeach()
endif()
