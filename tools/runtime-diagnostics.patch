+// saturn-recomp runtime — the step arithmetic of VDP1's shape drawing, kept apart from the
+// drawing so tests can check it. Clean-room: written from Sega's VDP1 User's Manual
+// (ST-013-R3-061694) and black-box comparison of output frames only.
+#pragma once
+#include <cstdint>
+
+namespace vdp1_steps {
+
+// a + (b - a) * k / n with an exact half rounded toward minus infinity.
+inline int lerp_half_down(int a, int b, int k, int n) {
+    if (n <= 0) return a;
+    const int64_t t = (int64_t)(b - a) * k * 2 - n;          // 2n * (exact offset) - n
+    const int64_t q = t >= 0 ? (t + 2 * n - 1) / (2 * n) : -((-t) / (2 * n));
+    return a + (int)q;
+}
+// a + (b - a) * k / n with an exact half rounded toward plus infinity.
+inline int lerp_half_up(int a, int b, int k, int n) {
+    if (n <= 0) return a;
+    const int64_t t = (int64_t)(b - a) * k * 2 + n;
+    const int64_t q = t >= 0 ? t / (2 * n) : -((-t + 2 * n - 1) / (2 * n));
+    return a + (int)q;
+}
+// a + (b - a) * k / n with an exact half rounded away from a.
+inline int lerp_half_away(int a, int b, int k, int n) {
+    if (n <= 0) return a;
+    const int64_t d = (int64_t)(b - a) * k * 2;
+    return a + (int)(d >= 0 ? (d + n) / (2 * n) : -((-d + n) / (2 * n)));
+}
+
+// Edge walk: the point of edge a->b at step i of n.
+inline int edge(int a, int b, int i, int n) { return lerp_half_down(a, b, i, n); }
+
+// The texel a dot takes along a span of `len + 1` steps over a character `span` texels long,
+// counted from the character's first texel, for an unflipped character. Shrinking (more texels
+// than steps): the texel under the step's centre, floor((q + 1/2) * span / (len + 1)).
+// Otherwise corner to corner: the first texel on the first step, the last on the last, an exact
+// half rounded down. Black-box: coordinate-coded characters (every texel holding its own
+// column and row) written into the reference's VRAM through its save state and drawn by it from
+// Shining Force III's own command lists (graveyard, field, bridge battle), compared with these
+// rules texel for texel; the manual puts the character's corners on the vertices but does not
+// give the sampling.
+inline int shrink_sample(int q, int span, int len) {
+    if (len < 0 || span <= 0) return 0;
+    const int s = (int)((int64_t)(2 * q + 1) * span / (2 * (len + 1)));
+    return s < span ? s : span - 1;
+}
+inline int stretch_sample(int q, int span, int len) {
+    if (len <= 0 || span <= 0) return 0;
+    return lerp_half_down(0, span - 1, q, len);
+}
+inline int sample(int q, int span, int len) {
+    return span > len + 1 ? shrink_sample(q, span, len) : stretch_sample(q, span, len);
+}
+// A flipped character is sampled as the unflipped one turned around: step q takes the texel
+// that step len - q would take unflipped, counted from the other end. (So an exact half or a
+// centre on a texel boundary goes the other way: toward the flipped character's first texel.)
+// Returned in drawing order, before the flip the texel fetch applies.
+inline int sample_flip(int q, int span, int len, bool flip) {
+    return flip ? span - 1 - sample(len - q, span, len) : sample(q, span, len);
+}
+// The texture column for dot k of a line of len + 1 dots, and the row for line i of n + 1.
+inline int column(int k, int w, int len, bool hflip = false) { return sample_flip(k, w, len, hflip); }
+inline int row(int i, int h, int n, bool vflip = false) { return sample_flip(i, h, n, vflip); }
+
+// High speed shrink (manual, PMOD bit 12 and FBCR EOS), applied to a line with fewer dots than
+// the character's width: the line steps over the character's w/2 column pairs as column() steps
+// over columns (flip included), and takes the even (eos 0) or odd (eos 1) column of each, counted
+// in the character as stored, so a flipped character keeps the parity of its stored columns.
+// Returns the column in drawing order, like column(). Black-box, as above.
+inline int hss_column(int k, int w, int len, bool hflip, int eos) {
+    const int half = w / 2;
+    if (half <= 0) return 0;
+    int j = column(k, half, len, hflip);
+    if (hflip) j = half - 1 - j;                       // the pair, counted in the stored character
+    int u = 2 * j + (eos & 1);
+    if (u > w - 1) u = w - 1;
+    return hflip ? w - 1 - u : u;
+}
+// The step an anti-aliasing dot (see aa_corner) takes its texel and Gouraud colour from: the
+// next step's, where the line is heading. Black-box, as above.
+inline int aa_step(int k, int len) { return k < len ? k + 1 : len; }
+
+// One Gouraud channel (5 bits) at step k of n between two colours: stepped as a texture is, over
+// the |b - a| + 1 values from a to b as if they were a character's texels (sample(): the centre
+// when there are more values than steps, else corner to corner, halves down), a falling run being
+// the rising one from b turned around (sample_flip()). Black-box: the reference drawing Shining
+// Force III's own command lists with every texel a flat mid grey and coded Gouraud tables written
+// into its VRAM, so each dot shows the Gouraud value; the manual gives the vertex colours only.
+inline int shade(int a, int b, int k, int n) {
+    const int span = (b > a ? b - a : a - b) + 1;
+    return b >= a ? a + sample(k, span, n) : b + sample(n - k, span, n);
+}
+// A quadrilateral's sides are walked together in n steps, n the longer side's length in dots
+// (the larger of |dx| and |dy|). Each side steps over its own length: walk step i of n is the
+// side's step i * len / n, an exact half taken toward the smaller coordinate on the side's major
+// axis (rounded down when that coordinate rises along the side, up when it falls), and the side's
+// point and Gouraud colour are those of its own step (side_point(), shade()). Black-box: the
+// reference's frames of Shining Force III's distorted sprites, where the shorter side's points and
+// colours otherwise land a dot or a shade off on exactly those halves.
+inline int side_step(int i, int len, int n, int major_delta) {
+    return major_delta >= 0 ? lerp_half_down(0, len, i, n) : lerp_half_up(0, len, i, n);
+}
+inline int side_point(int a, int b, int j, int len) { return lerp_half_down(a, b, j, len); }
+
+// Anti-aliasing (manual, figure 1.6): where a line steps both x and y, an extra pixel fills the
+// corner: (new x, old y) when x and y step the same way, (old x, new y) when they step opposite ways.
+struct Corner { int x, y; };
+inline Corner aa_corner(int x, int y, int xi, int yi) {
+    return xi == yi ? Corner{x + xi, y} : Corner{x, y + yi};
+}
+
+// Mesh (manual, PMOD bit 8): only the dots whose x and y have equal low bits are drawn.
+inline bool mesh_drawn(int x, int y) { return ((x ^ y) & 1) == 0; }
+
+// End codes (manual, ECD): an end code is transparent, and a line stops drawing at the second
+// end code read from the character. A texel repeated by enlargement is one read.
+struct EndCodes {
+    int seen = 0;
+    bool stopped = false;
+    // A texel read: returns false once the line has stopped.
+    bool read(bool end, bool new_texel) {
+        if (stopped) return false;
+        if (end && new_texel && ++seen == 2) stopped = true;
+        return !stopped;
+    }
+};
+
+}  // namespace vdp1_steps
