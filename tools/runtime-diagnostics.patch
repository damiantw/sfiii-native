diff --git a/runtime/tests/call_frames_test.cpp b/runtime/tests/call_frames_test.cpp
new file mode 100644
index 0000000..1efd736
--- /dev/null
+++ b/runtime/tests/call_frames_test.cpp
@@ -0,0 +1,47 @@
+// The calls in flight that a return past its caller unwinds to (src/core/call_frames.h).
+#include "test.h"
+#include "../src/core/call_frames.h"
+
+TEST(call_frames_find_the_innermost_call_returning_there) {
+    SH2CallFrames f;
+    f.push(0x06001000u);
+    f.push(0x06002000u);
+    f.push(0x06001000u);
+    CHECK_EQ(f.find(0x06001000u), 2L);
+    CHECK_EQ(f.find(0x06002000u), 1L);
+    CHECK_EQ(f.find(0x06003000u), -1L);
+}
+
+TEST(call_frames_stop_at_an_interrupt_barrier) {
+    SH2CallFrames f;
+    f.push(0x06001000u);
+    f.push(SH2CallFrames::kBarrier);
+    f.push(0x06002000u);
+    CHECK_EQ(f.find(0x06002000u), 2L);
+    CHECK_EQ(f.find(0x06001000u), -1L);
+    f.pop(1);
+    CHECK_EQ(f.find(0x06001000u), 0L);
+}
+
+// The shape of Sc3's X1RYUTA -> X006 06044550 call: the callee's rts lands on the return address of
+// the call that entered its caller, and that call goes on from there.
+static SH2CallFrames g_test_frames;
+static uint32_t outer_frame_resumed_at;
+static void inner_returns_past_its_caller(uint32_t outer_ret) {
+    SH2CallFrame caller(0x060602C0u);                   // the caller's call in flight
+    long depth = g_test_frames.find(outer_ret);
+    if (depth >= 0) throw SH2ReturnTo{outer_ret, (size_t)depth};
+}
+TEST(call_frames_unwind_to_the_waiting_call) {
+    SH2CallFrames* saved = g_sh2_frames;
+    g_sh2_frames = &g_test_frames;
+    {
+        SH2CallFrame outer(0x0605540Cu);
+        try { inner_returns_past_its_caller(0x0605540Cu); }
+        catch (const SH2ReturnTo& r) { if (r.depth == outer.depth) outer_frame_resumed_at = r.pc; else throw; }
+        CHECK_EQ(g_test_frames.size(), (size_t)1);   // the caller's frame is gone
+    }
+    CHECK_EQ(outer_frame_resumed_at, 0x0605540Cu);
+    CHECK_EQ(g_test_frames.size(), (size_t)0);
+    g_sh2_frames = saved;
+}
diff --git a/runtime/tests/memmap_test.cpp b/runtime/tests/memmap_test.cpp
new file mode 100644
index 0000000..6b71f96
--- /dev/null
+++ b/runtime/tests/memmap_test.cpp
@@ -0,0 +1,25 @@
+// The address map outside the work RAMs.
+#include "saturn.h"
+#include "test.h"
+
+// Backup RAM (64 KiB window at 0x00180000) repeats through 0x001FFFFF: Shining Force III
+// Scenario 3 reads a table at a negative index from 0x00200030 and lands at 0x001FFEAA.
+TEST(backup_ram_repeats_every_64k_up_to_the_low_work_ram) {
+    uint32_t keep = sh2_mmio_read(0x0018FEAB, 1);
+    sh2_mmio_write(0x0018FEAB, 0x5A, 1);
+    CHECK_EQ(sh2_io_read(0x001FFEAB, 1), 0x5Au);
+    CHECK_EQ(sh2_io_read(0x0019FEAB, 1), 0x5Au);
+    CHECK_EQ(sh2_io_read(0x201FFEAB, 1), 0x5Au);   // cache-through
+    sh2_io_write(0x001FFEAB, 0xA5, 1);
+    CHECK_EQ(sh2_mmio_read(0x0018FEAB, 1), 0xA5u);
+    sh2_mmio_write(0x0018FEAB, keep, 1);
+}
+
+// SINIT/MINIT (0x01000000-0x01FFFFFF) take writes only. Shining Force III Scenario 2 V2.000 reads a
+// battle table at index -1 and follows the word before it, 0x012C0002, as a pointer: a read there
+// must not stop the machine.
+TEST(sinit_minit_reads_float_high) {
+    CHECK_EQ(sh2_mmio_read(0x012C0002, 1), 0xFFu);
+    CHECK_EQ(sh2_mmio_read(0x012C0002, 2), 0xFFFFu);
+    CHECK_EQ(sh2_mmio_read(0x01800000, 4), 0xFFFFFFFFu);
+}
