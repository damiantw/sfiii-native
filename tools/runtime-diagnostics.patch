new file mode 100644
index 0000000..00c23c1
--- /dev/null
+++ b/runtime/src/host/frame_stats.h
@@ -0,0 +1,35 @@
+// saturn-recomp runtime — how evenly the window shows its pictures: intervals between presents
+// and the time each field took to run, for SF3_FRAMETIME (summary at exit, optional CSV).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+struct FrameStats {
+    std::vector<double> ms;  // one sample per event, milliseconds
+
+    void add(double v) { ms.push_back(v); }
+
+    struct Summary { size_t n = 0; double mean = 0, stddev = 0, p50 = 0, p99 = 0, max = 0; size_t over = 0; };
+
+    // `limit`: samples above it count in `over` (a picture held on screen too long, a late field).
+    Summary summary(double limit) const {
+        Summary s;
+        s.n = ms.size();
+        if (!s.n) return s;
+        double sum = 0;
+        for (double v : ms) { sum += v; s.over += v > limit; s.max = std::max(s.max, v); }
+        s.mean = sum / s.n;
+        double var = 0;
+        for (double v : ms) var += (v - s.mean) * (v - s.mean);
+        s.stddev = std::sqrt(var / s.n);
