diff --git a/runtime/tests/runtime_bench.cpp b/runtime/tests/runtime_bench.cpp
new file mode 100644
index 0000000..0603a4f
--- /dev/null
+++ b/runtime/tests/runtime_bench.cpp
@@ -0,0 +1,315 @@
+// runtime_bench: disc-free timings of the runtime's hot paths, for comparing hosts (Apple Silicon,
+// x86-64 Linux) and builds. No game code or game data: invented modules, command tables and
+// screens, fixed seeds. Each faster path is timed beside the path it stands in for, and its
+// output is checked against it; any difference fails the run.
+//   runtime_bench [--quick] [--markdown] [--json FILE]
+//
+// vdp1   VDP1 command tables drawn into the native framebuffer: the native line walk against
+//        the general walk (vdp1_reference_raster).
+// vdp2   VDP2 composition of a 320x224 field (two bitmap screens, sprites, colour calculation):
+//        bands of rows on worker threads against all rows on one thread.
+// lookup sh2_lookup over an invented module table with an overlay swapped at one address; also
+//        checks that the lookup cache sees a module header overwritten in memory.
+#include "saturn/sh2.h"
+#include "video.h"
+#include <algorithm>
+#include <array>
+#include <utility>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+// ---- an invented module table (what a game's generated modules.cpp defines) -----------------
+namespace {
+template <int N> void fn(SH2Context& c) { c.r[0] += N; }
+template <int... I> constexpr std::array<SH2Func, sizeof...(I)> fns(std::integer_sequence<int, I...>) { return {&fn<I>...}; }
+const auto kFns = fns(std::make_integer_sequence<int, 64>{});
+
+SH2Module g_boot{"BENCH_BOOT", 0x06004000, 0x40000, 0, nullptr, 0, nullptr, nullptr, false};
+SH2Module g_ova{"BENCH_OVA", 0x06050000, 0x20000, 0, nullptr, 0, nullptr, nullptr, true};
+SH2Module g_ovb{"BENCH_OVB", 0x06050000, 0x20000, 0, nullptr, 0, nullptr, nullptr, true};
+SH2Module g_low{"BENCH_LOW", 0x00200000, 0x40000, 0, nullptr, 0, nullptr, nullptr, true};
+std::vector<SH2FuncEntry> g_entries[4];
+}  // namespace
+
+extern const SH2Module* const g_sh2_modules[] = {&g_boot, &g_ova, &g_ovb, &g_low};
+extern const int g_sh2_nmodules = 4;
+extern const uint32_t g_sh2_tasks[2] = {0, 0};
+extern const SH2TaskSwitch g_sh2_task_switches[] = {{0, 0, 0, 0, 0}};
+extern const int g_sh2_ntask_switches = 0;
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+double ms_since(Clock::time_point t) { return std::chrono::duration<double, std::milli>(Clock::now() - t).count(); }
+
+struct Row { std::string group, name, unit; double base, fast; };
+std::vector<Row> g_rows;
+int g_failures;
+void fail(const char* what) { std::fprintf(stderr, "FAIL: %s\n", what); ++g_failures; }
+
+uint64_t fnv(const void* p, size_t n, uint64_t h = 1469598103934665603ull) {
+    for (size_t i = 0; i < n; ++i) { h ^= ((const uint8_t*)p)[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+// ---- VDP1 -------------------------------------------------------------------------------
+void be16(uint32_t a, uint16_t v) { g_vdp1_vram[a & 0x7FFFF] = (uint8_t)(v >> 8); g_vdp1_vram[(a + 1) & 0x7FFFF] = (uint8_t)v; }
+
+struct Table {
+    uint32_t a = 0;
+    void cmd(uint16_t ctrl, uint16_t pmod, uint16_t colr, uint32_t srca, int w, int h, const int* xy, uint32_t grda = 0) {
+        be16(a, ctrl); be16(a + 2, 0); be16(a + 4, pmod); be16(a + 6, colr); be16(a + 8, (uint16_t)(srca / 8));
+        be16(a + 10, (uint16_t)((w / 8) << 8 | h));
+        for (int i = 0; i < 8; ++i) be16(a + 12 + i * 2, (uint16_t)(xy[i] & 0x1FFF));
+        be16(a + 28, (uint16_t)(grda / 8)); be16(a + 30, 0);
+        a += 0x20;
+    }
+    void end() { be16(a, 0x8000); }
+};
+
+// Textures from 0x20000: 16-bit RGB and 4-bit colour-table characters, transparent dots and all.
+void textures(std::mt19937& rng) {
+    for (uint32_t a = 0x20000; a < 0x80000; a += 2) {
+        uint32_t r = rng();
+        uint16_t v = (r & 7) == 0 ? 0 : (uint16_t)(0x8000 | (r >> 8 & 0x7FFF));
+        be16(a, v);
+    }
+    for (uint32_t a = 0x7F000; a < 0x7F800; a += 2) be16(a, (uint16_t)(0x8000 | (rng() & 0x7FFF)));   // colour tables
+    for (uint32_t a = 0x7F800; a < 0x80000; a += 2) be16(a, (uint16_t)(rng() & 0x7FFF));             // Gouraud tables
+}
+
+void scene(const char* name, std::mt19937& rng, Table& t) {
+    auto r = [&](int lo, int hi) { return std::uniform_int_distribution<int>(lo, hi)(rng); };
+    int sys[8] = {0, 0, 0, 0, 319, 223, 0, 0};
+    t.cmd(0x0009, 0, 0, 0, 0, 0, sys);
+    int user[8] = {0, 0, 0, 0, 319, 223, 0, 0};
+    t.cmd(0x0008, 0, 0, 0, 0, 0, user);
+    int local[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    t.cmd(0x000A, 0, 0, 0, 0, 0, local);
+    std::string s = name;
+    auto tex = [&](int w, int h) { return (uint32_t)(0x20000 + r(0, (0x5E000 - w * h * 2) / 8) * 8); };
+    if (s == "sprites") {                       // normal sprites, 32x32, RGB and colour table
+        for (int i = 0; i < 400; ++i) {
+            int xy[8] = {r(-16, 304), r(-16, 208)};
+            bool lut = i & 1;
+            t.cmd((uint16_t)(0x0000 | r(0, 3) << 4), (uint16_t)((lut ? 1 : 5) << 3 | 0x80),
+                  (uint16_t)(lut ? (0x7F000 + r(0, 63) * 32) / 8 : 0), tex(32, 32), 32, 32, xy);
+        }
+    } else if (s == "scaled") {                 // scaled sprites, 32x32 to 16..64 on screen
+        for (int i = 0; i < 200; ++i) {
+            int x = r(-20, 300), y = r(-20, 200), w = r(16, 64), h = r(16, 64);
+            int xy[8] = {x, y, 0, 0, x + w, y + h};
+            t.cmd(0x0001, 5 << 3 | 0x80, 0, tex(32, 32), 32, 32, xy);
+        }
+    } else if (s == "floor") {                  // distorted sprites as perspective floor tiles, some shaded
+        for (int row = 0; row < 14; ++row)
+            for (int col = 0; col < 20; ++col) {
+                double y0 = 40 + row * row * 0.95, y1 = 40 + (row + 1) * (row + 1) * 0.95;
+                double s0 = 0.4 + row * 0.07, s1 = 0.4 + (row + 1) * 0.07;
+                auto px = [&](double c, double sc) { return (int)(160 + (c - 10) * 32 * sc); };
+                int xy[8] = {px(col, s0), (int)y0, px(col + 1, s0), (int)y0, px(col + 1, s1), (int)y1, px(col, s1), (int)y1};
+                bool shade = (row + col) % 3 == 0;
+                t.cmd(0x0002, (uint16_t)(5 << 3 | 0x80 | (shade ? 4 : 0)), 0, tex(32, 32), 32, 32, xy,
+                      0x7F800 + r(0, 255) * 8);
+            }
+    } else {                                    // untextured polygons: Gouraud, half-transparency
+        for (int i = 0; i < 300; ++i) {
+            int x = r(0, 300), y = r(0, 200);
+            int xy[8] = {x, y, x + r(5, 60), y + r(-10, 10), x + r(5, 60), y + r(5, 60), x + r(-10, 10), y + r(5, 60)};
+            uint16_t ccb = (uint16_t)(i % 4 == 0 ? 4 : i % 4 == 1 ? 3 : 0);
+            t.cmd(0x0004, (uint16_t)(0xC0 | ccb), (uint16_t)(0x8000 | r(0, 0x7FFF)), 0, 0, 0, xy, 0x7F800 + r(0, 255) * 8);
+        }
+    }
+    t.end();
+}
+
+uint64_t fb_hash(int* lit = nullptr) {
+    std::vector<uint16_t> fb(512 * 256);
+    for (int i = 0; i < 512 * 256; ++i) fb[i] = (uint16_t)vdp1_fb_read(i * 2, 2);
+    if (lit) *lit = (int)std::count_if(fb.begin(), fb.end(), [](uint16_t d) { return d != 0; });
+    return fnv(fb.data(), fb.size() * 2);
+}
+void fb_clear() { for (int i = 0; i < 512 * 256; ++i) vdp1_fb_write(i * 2, 0, 2); }
+
+void bench_vdp1(bool quick) {
+    vdp1_init();
+    vdp1_reg_write(0x00, 0, 2);                          // TVMR: 16 bits a pixel
+    vdp1_reg_write(0x02, 0, 2);
+    for (const char* name : {"sprites", "scaled", "floor", "polygons"}) {
+        std::mt19937 rng(1996);
+        std::memset(g_vdp1_vram, 0, sizeof g_vdp1_vram);
+        textures(rng);
+        Table t;
+        scene(name, rng, t);
+        const int draws = quick ? 10 : 150;
+        double ms[2];
+        uint64_t hash[2];
+        for (int reference = 1; reference >= 0; --reference) {
+            vdp1_reference_raster(reference);
+            fb_clear();
+            vdp1_reg_write(0x04, 1, 2);
+            int lit = 0;
+            hash[reference] = fb_hash(&lit);
+            if (lit < 320 * 224 / 5) fail((std::string("vdp1 ") + name + ": the invented scene did not draw").c_str());
+            if (std::getenv("BENCH_VERBOSE")) std::fprintf(stderr, "vdp1 %s: %d dots drawn\n", name, lit);
+            auto t0 = Clock::now();
+            for (int i = 0; i < draws; ++i) vdp1_reg_write(0x04, 1, 2);    // PTMR 1: draw now
+            ms[reference] = ms_since(t0) / draws;
+        }
+        vdp1_reference_raster(false);
+        if (hash[0] != hash[1]) fail((std::string("vdp1 ") + name + ": native walk differs from the general walk").c_str());
+        g_rows.push_back({"vdp1", name, "ms/draw", ms[1], ms[0]});
+    }
+}
+
+// ---- VDP2 -------------------------------------------------------------------------------
+void reg2(uint32_t off, uint16_t v) { g_vdp2_regs[off] = v >> 8; g_vdp2_regs[off + 1] = (uint8_t)v; }
+
+void bench_vdp2(bool quick) {
+    std::mt19937 rng(1998);
+    std::memset(g_vdp2_regs, 0, sizeof g_vdp2_regs);
+    for (auto& b : g_vdp2_vram) b = (uint8_t)rng();
+    for (size_t i = 0; i < sizeof g_vdp2_cram; i += 2) { uint16_t v = (uint16_t)(rng() & 0x7FFF); g_vdp2_cram[i] = v >> 8; g_vdp2_cram[i + 1] = (uint8_t)v; }
+    reg2(0x00, 0x8000);                          // TVMD: display on, 320x224
+    reg2(0x20, 0x0003);                          // BGON: NBG0, NBG1
+    reg2(0x28, 0x1212);                          // CHCTLA: NBG0 and NBG1 bitmaps, 256 colours, 512x256
+    reg2(0x3C, 0x0010);                          // MPOFN: NBG1's bitmap at 0x20000
+    reg2(0x78, 0x0001); reg2(0x7C, 0x0001);      // NBG0 zoom 1.0
+    reg2(0x88, 0x0001); reg2(0x8C, 0x0001);      // NBG1 zoom 1.0
+    reg2(0x80, 0x0013); reg2(0x84, 0x0007);      // NBG1 scrolled
+    reg2(0xF8, 0x0302);                          // PRINA: NBG0 2, NBG1 3
+    reg2(0xF0, 0x0505); reg2(0xF2, 0x0505); reg2(0xF4, 0x0505); reg2(0xF6, 0x0505);   // sprites 5
+    reg2(0xE0, 0x0020);                          // SPCTL: RGB and palette sprite dots
+    reg2(0xEC, 0x0002);                          // CCCTL: NBG1 colour calculation
+    reg2(0x108, 0x0C00);                         // CCRNA: NBG1 ratio
+    reg2(0xAC, 0x0003); reg2(0xAE, 0xFFFF);      // back screen at the end of VRAM
+    // VDP1 shows sprites: rectangles of RGB dots and transparent gaps
+    for (int y = 0; y < 256; ++y)
+        for (int x = 0; x < 512; ++x) {
+            bool on = ((x / 24 + y / 20) % 3) != 0;
+            vdp1_fb_write((uint32_t)(y * 512 + x) * 2, on ? (uint32_t)(0x8000 | ((x * 7 + y * 3) & 0x7FFF)) : 0, 2);
+        }
+    vdp1_vblank_out();
+    const int frames = quick ? 20 : 300;
+    double ms[2];
+    uint64_t hash[2];
+    for (int serial = 1; serial >= 0; --serial) {
+        vdp2_serial_composition(serial);
+        Frame f;
+        vdp2_compose(f);
+        hash[serial] = fnv(f.px.data(), f.px.size() * 4);
+        size_t lit = std::count_if(f.px.begin(), f.px.end(), [](uint32_t p) { return p != 0; });
+        if (f.w != 320 || f.h != 224 || lit < f.px.size() / 2) fail("vdp2: the invented screen did not show");
+        auto t0 = Clock::now();
+        for (int i = 0; i < frames; ++i) vdp2_compose(f);
+        ms[serial] = ms_since(t0) / frames;
+    }
+    vdp2_serial_composition(false);
+    if (hash[0] != hash[1]) fail("vdp2: rows composed on worker threads differ from one thread's");
+    g_rows.push_back({"vdp2", std::string("compose 320x224 (") + std::to_string(std::thread::hardware_concurrency()) + " hw threads)",
+                      "ms/field", ms[1], ms[0]});
+}
+
+// ---- sh2_lookup -------------------------------------------------------------------------
+uint8_t* mem(uint32_t a) { return a >> 20 == 0x060 ? g_wram_h + (a & 0xFFFFF) : g_wram_l + (a & 0xFFFFF); }
+
+void image(SH2Module& m, uint32_t seed, int stride, int offset) {
+    std::mt19937 rng(seed);
+    for (uint32_t i = 0; i < m.size; ++i) mem(m.base)[i] = (uint8_t)rng();
+    m.crc = sh2_crc32(mem(m.base), m.size);
+    auto& e = g_entries[&m == &g_boot ? 0 : &m == &g_ova ? 1 : &m == &g_ovb ? 2 : 3];
+    e.clear();
+    for (uint32_t a = (uint32_t)offset; a < m.size; a += (uint32_t)stride) e.push_back({m.base + a, kFns[(a / stride) & 63]});
+    m.funcs = e.data(); m.nfuncs = (uint32_t)e.size();
+}
+
+SH2Func expected(const SH2Module& m, uint32_t addr) {
+    for (uint32_t i = 0; i < m.nfuncs; ++i) if (m.funcs[i].addr == addr) return m.funcs[i].fn;
+    return nullptr;
+}
+
+void bench_lookup(bool quick) {
+    image(g_ovb, 3, 0x40, 0x10);                 // B's image first: its CRC from its own bytes
+    std::vector<uint8_t> ovb(mem(g_ovb.base), mem(g_ovb.base) + g_ovb.size);
+    image(g_boot, 1, 0x20, 0);
+    image(g_ova, 2, 0x40, 0);
+    image(g_low, 4, 0x30, 0);
+    sh2_activate(&g_boot); sh2_activate(&g_low); sh2_activate(&g_ova);
+    // a trace: hot functions called again and again, as a game's main loop does
+    std::mt19937 rng(2026);
+    std::vector<uint32_t> hot;
+    for (int i = 0; i < 1500; ++i) {
+        const SH2Module& m = i % 3 == 0 ? g_boot : i % 3 == 1 ? g_ova : g_low;
+        hot.push_back(m.funcs[rng() % m.nfuncs].addr);
+    }
+    std::vector<uint32_t> trace(1 << 16);
+    std::geometric_distribution<int> pick(0.01);
+    for (auto& a : trace) a = hot[std::min<int>(pick(rng), (int)hot.size() - 1)];
+    for (uint32_t a : hot) {
+        const SH2Module& m = a >> 20 == 0x002 ? g_low : a < g_ova.base ? g_boot : g_ova;
+        if (sh2_lookup(a) != expected(m, a)) { fail("lookup: wrong function"); break; }
+    }
+    const long n = quick ? 2000000 : 40000000;
+    uintptr_t sink = 0;
+    auto t0 = Clock::now();
+    for (long i = 0; i < n; ++i) sink += (uintptr_t)sh2_lookup(trace[i & 0xFFFF]);
+    double ns = ms_since(t0) * 1e6 / n;
+    if (!sink) fail("lookup: nothing found");
+    g_rows.push_back({"lookup", "sh2_lookup, 1500 hot entries", "ns/lookup", 0, ns});
+    // An overlay loaded over A (by the module loader, DMA or the CPU): an address that was A's
+    // entry must now come from B, or from nothing, exactly as without the cache.
+    const uint32_t a_only = g_ova.base + 0x40;               // A's entry, not B's
+    const uint32_t b_only = g_ovb.base + 0x50;               // B's entry, not A's
+    if (sh2_lookup(a_only) != expected(g_ova, a_only)) fail("lookup: A before the swap");
+    std::memcpy(mem(g_ovb.base), ovb.data(), ovb.size());
+    if (sh2_lookup(a_only) != nullptr) fail("lookup: A's entry still found after B was loaded over it");
+    if (sh2_lookup(b_only) != expected(g_ovb, b_only)) fail("lookup: B's entry after the swap");
+    // a header byte overwritten in place: an unknown image, so nothing is trusted there
+    mem(g_ovb.base)[5] ^= 0xFF;
+    if (sh2_lookup(b_only) != nullptr) fail("lookup: an entry found in an overwritten image");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    bool quick = false, markdown = false;
+    const char* json = nullptr;
+    for (int i = 1; i < argc; ++i) {
+        if (!std::strcmp(argv[i], "--quick")) quick = true;
+        else if (!std::strcmp(argv[i], "--markdown")) markdown = true;
+        else if (!std::strcmp(argv[i], "--json") && i + 1 < argc) json = argv[++i];
+        else { std::fprintf(stderr, "usage: runtime_bench [--quick] [--markdown] [--json FILE]\n"); return 2; }
+    }
+    bench_lookup(quick);
+    bench_vdp1(quick);
+    bench_vdp2(quick);
+    if (markdown) {
+        std::printf("| group | case | unit | reference path | fast path | speed-up |\n|---|---|---|---:|---:|---:|\n");
+        for (auto& r : g_rows)
+            if (r.base > 0) std::printf("| %s | %s | %s | %.3f | %.3f | %.2fx |\n", r.group.c_str(), r.name.c_str(), r.unit.c_str(), r.base, r.fast, r.base / r.fast);
+            else std::printf("| %s | %s | %s | | %.2f | |\n", r.group.c_str(), r.name.c_str(), r.unit.c_str(), r.fast);
+    } else {
+        for (auto& r : g_rows)
+            if (r.base > 0) std::printf("%-7s %-34s %9.3f -> %9.3f %-9s (%.2fx)\n", r.group.c_str(), r.name.c_str(), r.base, r.fast, r.unit.c_str(), r.base / r.fast);
+            else std::printf("%-7s %-34s %9s    %9.2f %-9s\n", r.group.c_str(), r.name.c_str(), "", r.fast, r.unit.c_str());
+    }
+    if (json) {
+        FILE* f = std::fopen(json, "w");
+        if (f) {
+            std::fprintf(f, "{\"quick\": %s, \"rows\": [", quick ? "true" : "false");
+            for (size_t i = 0; i < g_rows.size(); ++i)
+                std::fprintf(f, "%s{\"group\": \"%s\", \"case\": \"%s\", \"unit\": \"%s\", \"reference\": %.4f, \"fast\": %.4f}", i ? ", " : "",
+                             g_rows[i].group.c_str(), g_rows[i].name.c_str(), g_rows[i].unit.c_str(), g_rows[i].base, g_rows[i].fast);
+            std::fprintf(f, "], \"failures\": %d}\n", g_failures);
+            std::fclose(f);
+        }
+    }
+    if (g_failures) std::fprintf(stderr, "%d check(s) failed\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/runtime/tests/scsp_replay.cpp b/runtime/tests/scsp_replay.cpp
new file mode 100644
index 0000000..068aa64
--- /dev/null
+++ b/runtime/tests/scsp_replay.cpp
@@ -0,0 +1,92 @@
+// SCSP replay: the sound chip alone, outside any game, from a script, so the same registers and
+// sound RAM given to a reference can be compared sample for sample (no 68000, no game timing).
+//   scsp_replay SCRIPT.bin OUT.raw
+// SCRIPT.bin: sound RAM (512 KiB, as the bus sees it), then records of little-endian u32 words:
+//   1 OFF VALUE      a 16-bit register write (OFF 0x000-0xFFF)
+//   2 N              N samples, appended to OUT.raw as 16-bit little-endian stereo
+//   3 L R            the external input (EXTS 0-1) from here on
+//   4 FIELD I V      scsp_set_internal(FIELD, I, V): inner state (sound.h's ScspField)
+//   5 FIELD N        print scsp_get_internal(FIELD, 0..N-1) on a line to stdout
+//   6 REG V          the 68000's register REG (Musashi's m68k_register_t) = V
+//   7 ON             the 68000 runs (1) or not (0) beside the samples, from the registers given
+//   8 ADDR N         print N bytes of sound RAM from ADDR as hex on a line to stdout
+//   9                print the 68000's registers D0-D7 A0-A7 PC SR USP ISP on a line to stdout
+#include "../src/sound/sound.h"
+#include "m68k.h"
+#include <cstdio>
+#include <algorithm>
+#include <cstring>
+#include <vector>
+
+int main(int argc, char** argv) {
+    if (argc < 3) { std::fprintf(stderr, "usage: scsp_replay SCRIPT.bin OUT.raw\n"); return 2; }
+    FILE* f = std::fopen(argv[1], "rb");
+    if (!f) return 1;
+    std::vector<uint8_t> in;
+    uint8_t buf[65536];
+    for (size_t n; (n = std::fread(buf, 1, sizeof buf, f)) > 0;) in.insert(in.end(), buf, buf + n);
+    std::fclose(f);
+    if (in.size() < sizeof g_sound_ram) { std::fprintf(stderr, "short script\n"); return 1; }
+    scsp_reset();
+    sound_replay_cpu(false);    // Musashi's tables, before any register is set
+    std::memcpy(g_sound_ram, in.data(), sizeof g_sound_ram);
+    FILE* o = std::fopen(argv[2], "wb");
+    if (!o) return 1;
+    auto word = [&](size_t& p) { uint32_t v; std::memcpy(&v, &in[p], 4); p += 4; return v; };
+    int16_t ext[2] = {0, 0};
+    for (size_t p = sizeof g_sound_ram; p + 4 <= in.size();) {
+        uint32_t op = word(p);
+        if (op == 1) { uint32_t off = word(p), v = word(p); scsp_write(off, v, 2); }
+        else if (op == 2) {
+            for (uint32_t i = word(p); i--;) {
+                int16_t s[2];
+                sound_replay_sample(ext[0], ext[1], s);
+                uint8_t le[4] = {(uint8_t)s[0], (uint8_t)(s[0] >> 8), (uint8_t)s[1], (uint8_t)(s[1] >> 8)};
+                std::fwrite(le, 1, 4, o);
+            }
+        } else if (op == 3) { ext[0] = (int16_t)word(p); ext[1] = (int16_t)word(p); }
+        else if (op == 5) {     // print a field for indices 0..N-1 to stdout
+            uint32_t fl = word(p), n = word(p);
+            std::printf("F%u", fl);
+            for (uint32_t i = 0; i < n; ++i) std::printf(" %d", (int)scsp_get_internal((ScspField)fl, (int)i));
+            std::printf("\n");
+        }
+        else if (op == 6) { uint32_t reg = word(p), v = word(p); m68k_set_reg((m68k_register_t)reg, v); }
+        else if (op == 7) sound_replay_cpu(word(p) != 0);
+        else if (op == 8) {
+            uint32_t a = word(p), n = word(p);
+            std::printf("M%u ", a);
+            for (uint32_t i = 0; i < n; ++i) std::printf("%02x", g_sound_ram[(a + i) & 0x7FFFF]);
+            std::printf("\n");
+        }
+        else if (op == 9) {
+            std::printf("R");
+            for (int i = 0; i <= 20; ++i) if (i != 18) std::printf(" %x", m68k_get_reg(nullptr, (m68k_register_t)i));
+            std::printf("\n");
+        }
+        else if (op == 10) {    // profile the 68000's PCs from here on (N = 1) or print the top N
+            extern uint32_t* g_m68k_pc_hist;
+            static std::vector<uint32_t> hist(0x40000);
+            uint32_t n = word(p);
+            if (n == 1) { std::fill(hist.begin(), hist.end(), 0); g_m68k_pc_hist = hist.data(); }
+            else {
+                std::vector<uint32_t> idx(hist.size());
+                for (uint32_t i = 0; i < idx.size(); ++i) idx[i] = i;
+                std::partial_sort(idx.begin(), idx.begin() + n, idx.end(), [&](uint32_t a, uint32_t b) { return hist[a] > hist[b]; });
+                for (uint32_t k = 0; k < n && hist[idx[k]]; ++k) {
+                    char s[128]; unsigned len = m68k_disassemble(s, idx[k] * 2, M68K_CPU_TYPE_68000);
+                    printf("P %05X %9u %u %s\n", idx[k] * 2, hist[idx[k]], len, s);
+                }
+            }
+        }
+        else if (op == 11) {    // disassemble N instructions from ADDR
+            uint32_t a = word(p), n = word(p);
+            for (uint32_t k = 0; k < n; ++k) { char s[128]; unsigned len = m68k_disassemble(s, a, M68K_CPU_TYPE_68000); printf("D %05X %s\n", a, s); a += len; }
+        }
+        else if (op == 12) sound_replay_first_slice((int)word(p));   // 68000 cycles before the next sample
+        else if (op == 4) { uint32_t fl = word(p), i = word(p), v = word(p); scsp_set_internal((ScspField)fl, (int)i, v); }
+        else { std::fprintf(stderr, "bad op %u\n", op); return 1; }
+    }
+    std::fclose(o);
+    return 0;
+}
diff --git a/runtime/tests/scsp_test.cpp b/runtime/tests/scsp_test.cpp
new file mode 100644
index 0000000..6c0d3f1
--- /dev/null
+++ b/runtime/tests/scsp_test.cpp
@@ -0,0 +1,155 @@
+// The SCSP and the sound 68000 against numbers measured on Beetle Saturn as a black box (its output
+// and save states only).
+#include <cstring>
+#include "m68k.h"
+#include "../src/sound/sound.h"
+#include "saturn.h"
+#include <cstdio>
+#include "test.h"
+
+// A released slot stops once its envelope reaches 0x3C0: it still plays that sample, then its
+// attenuation reads 0x3FF and it no longer runs. Below 0x3C0 it keeps going.
+TEST(a_released_slot_stops_when_its_envelope_reaches_0x3C0) {
+    scsp_reset();
+    int16_t out[2];
+    scsp_set_internal(SCSP_PLAYING, 0, 1); scsp_set_internal(SCSP_ENV_PHASE, 0, 3); scsp_set_internal(SCSP_ENV, 0, 0x3BF);
+    scsp_set_internal(SCSP_PLAYING, 1, 1); scsp_set_internal(SCSP_ENV_PHASE, 1, 3); scsp_set_internal(SCSP_ENV, 1, 0x3C0);
+    scsp_sample(0, 0, out);
+    CHECK_EQ(scsp_get_internal(SCSP_PLAYING, 0), 1u);     // RR 0: the envelope holds
+    CHECK_EQ(scsp_get_internal(SCSP_ENV, 0), 0x3BFu);
+    CHECK_EQ(scsp_get_internal(SCSP_PLAYING, 1), 0u);
+    CHECK_EQ(scsp_get_internal(SCSP_ENV, 1), 0x3FFu);
+}
+
+// The 68000's loop BODY; addq.l #1,d7; bra.s back, run for 735 samples (256 cycles each) with
+// interrupts masked: the iterations, D7.
+static uint32_t loop_iterations(const char* hex) {
+    scsp_reset();
+    sound_replay_cpu(false);
+    std::memset(g_sound_ram, 0, sizeof g_sound_ram);
+    uint8_t code[64]; size_t n = 0;
+    for (const char* p = hex; p[0] && p[1]; p += 2) { unsigned b; sscanf(p, "%2x", &b); code[n++] = (uint8_t)b; }
+    code[n++] = 0x52; code[n++] = 0x87;                  // addq.l #1,d7
+    code[n] = 0x60; code[n + 1] = (uint8_t)-(int)(n + 2); n += 2;   // bra.s to the body
+    std::memcpy(g_sound_ram + 0x7E000, code, n);
+    for (int r = M68K_REG_D0; r <= M68K_REG_A6; ++r) m68k_set_reg((m68k_register_t)r, r >= M68K_REG_A0 ? 0x70000 : 0);
+    m68k_set_reg(M68K_REG_SR, 0x2700);
+    m68k_set_reg(M68K_REG_A7, 0x7F000);
+    m68k_set_reg(M68K_REG_PC, 0x7E000);
+    sound_replay_cpu(true);
+    int16_t out[2];
+    for (int i = 0; i < 735; ++i) sound_replay_sample(0, 0, out);
+    sound_replay_cpu(false);
+    return m68k_get_reg(nullptr, M68K_REG_D7);
+}
+
+// Cycles per iteration on Beetle (the loop's own addq.l and bra.s are 24): the 68000 manual's
+// counts plus 2 per bus access, and the instructions Beetle times otherwise.
+TEST(the_sound_68000_runs_loops_at_beetles_speed) {
+    struct { const char* body; uint32_t cycles; } cases[] = {
+        {"", 24},                                // addq.l 8 + 2, bra.s 10 + 4
+        {"4e71", 30},                            // nop
+        {"3010", 36},                            // move.w (a0),d0
+        {"2010", 42},                            // move.l (a0),d0
+        {"30390007 0000", 48},                   // move.w $70000,d0
+        {"d081", 34},                            // add.l d1,d0
+        {"b081", 30},                            // cmp.l d1,d0
+        {"d2fc0060", 40},                        // adda.w #$60,a1
+        {"544a", 34},                            // addq.w #2,a2
+        {"3100", 38},                            // move.w d0,-(a0)
+        {"08810003", 36},                        // bclr #3,d1
+        {"61026002 4e75", 82},                   // bsr.s; bra.s; rts
+        {"487a0004 4e75", 66},                   // pea; rts
+        {"4eba0004 6002 4e75", 80},              // jsr d16(pc); bra.s; rts
+        {"4efb0002", 38},                        // jmp 2(pc,d0.w)
+    };
+    for (auto& c : cases) {
+        char hex[64]; size_t k = 0;
+        for (const char* p = c.body; *p; ++p) if (*p != ' ') hex[k++] = *p;
+        hex[k] = 0;
+        uint32_t it = loop_iterations(hex), want = 735 * 256 / c.cycles;
+        if (it + 1 < want || it > want + 1) CHECK_EQ(it, want);
+    }
+}
+
+// Timer A polled the way the sound driver does: clear SCIRE bit 6, load TIMA, then count polls
+// of SCIPD bit 6 until the timer overflows; D7 per tick is stored at 0x70000. Beetle's counts fit
+// one rule (checked offline against 11 TIMA/prescale cases): the timer steps at each sample
+// boundary whose global sample number is a multiple of the prescale, a read sees the state at
+// the time of its access, and loading TIMA does not restart the prescaler.
+static void timer_a_polls(uint8_t tima, uint8_t ctl, uint16_t* counts, int n) {
+    scsp_reset();
+    sound_replay_cpu(false);
+    std::memset(g_sound_ram, 0, sizeof g_sound_ram);
+    const uint8_t code[] = {
+        0x4b, 0xf9, 0x00, 0x10, 0x00, 0x00,          // lea $100000,a5
+        0x41, 0xf9, 0x00, 0x07, 0x00, 0x00,          // lea $70000,a0
+        0x3b, 0x7c, 0x00, 0x40, 0x04, 0x22,          // move.w #$40,$422(a5)   SCIRE
+        0x3b, 0x7c, ctl, tima, 0x04, 0x18,           // move.w #ctl:tima,$418(a5)
+        0x7e, 0x00,                                  // moveq #0,d7
+        0x52, 0x87,                                  // addq.l #1,d7
+        0x30, 0x2d, 0x04, 0x20,                      // move.w $420(a5),d0    SCIPD
+        0x08, 0x00, 0x00, 0x06,                      // btst #6,d0
+        0x67, 0xf4,                                  // beq.s addq
+        0x30, 0xc7,                                  // move.w d7,(a0)+
+        0x60, 0xe2,                                  // bra.s SCIRE
+    };
+    std::memcpy(g_sound_ram + 0x7E000, code, sizeof code);
+    for (int r = M68K_REG_D0; r <= M68K_REG_A6; ++r) m68k_set_reg((m68k_register_t)r, 0);
+    m68k_set_reg(M68K_REG_SR, 0x2700);
+    m68k_set_reg(M68K_REG_A7, 0x7F000);
+    m68k_set_reg(M68K_REG_PC, 0x7E000);
+    sound_replay_cpu(true);
+    int16_t out[2];
+    for (int i = 0; i < 735; ++i) sound_replay_sample(0, 0, out);
+    sound_replay_cpu(false);
+    for (int i = 0; i < n; ++i) counts[i] = (uint16_t)(g_sound_ram[0x70000 + 2 * i] << 8 | g_sound_ram[0x70001 + 2 * i]);
+}
+
+// The counts below are what that rule gives for this start (program at the first cycle of sample
+// 0), so they pin the rule rather than our own output.
+TEST(timer_a_ticks_on_global_sample_boundaries_like_beetle) {
+    struct { uint8_t tima, ctl; int n; uint16_t want[8]; } cases[] = {
+        {0xFF, 0, 8, {4, 4, 3, 3, 4, 3, 3, 4}},
+        {0xFE, 0, 8, {9, 8, 8, 8, 8, 8, 9, 8}},
+        {0xF0, 0, 8, {75, 75, 74, 75, 74, 75, 74, 75}},
+        {0xFF, 1, 8, {4, 8, 9, 8, 8, 8, 8, 8}},
+        {0x80, 1, 2, {1209, 1212}},
+        {0xF0, 2, 8, {289, 302, 302, 302, 302, 302, 302, 302}},
+    };
+    for (auto& c : cases) {
+        uint16_t got[8];
+        timer_a_polls(c.tima, c.ctl, got, c.n);
+        for (int i = 0; i < c.n; ++i) CHECK_EQ(got[i], c.want[i]);
+    }
+}
+
+// An SH-2 access to sound RAM between two polls first brings the 68000 up to the master's time
+// (sat_now_cpu: the poll's time plus what the master has spent since), to the cycle.
+TEST(an_sh2_sound_access_runs_the_68000_up_to_the_masters_time) {
+    sound_replay_cpu(false);
+    sound_power(false);
+    std::memset(g_sound_ram, 0, sizeof g_sound_ram);
+    const uint8_t vec[] = {0x00, 0x07, 0xF0, 0x00, 0x00, 0x07, 0xE0, 0x00};   // SSP, PC
+    std::memcpy(g_sound_ram, vec, sizeof vec);
+    const uint8_t loop[] = {0x52, 0x87, 0x60, 0xFC};                          // addq.l #1,d7; bra.s
+    std::memcpy(g_sound_ram + 0x7E000, loop, sizeof loop);
+    SH2Context* const was = g_cpu;
+    g_cpu = &g_master;
+    const int32_t budget = g_master.budget;
+    g_master.budget = 0;                          // its slice spent
+    sound_power(true);
+    m68k_set_reg(M68K_REG_D7, 0);
+    sound_read(0x05A00000u, 2);
+    const uint64_t t0 = sat_now_cpu();
+    const uint32_t d0 = m68k_get_reg(nullptr, M68K_REG_D7);
+    g_master.budget -= 4 * 28636;                 // 28 636 cycles more (overspent): 1 ms at 28.6364 MHz
+    CHECK_EQ(sat_now_cpu() - t0 + 1 >= 999990 && sat_now_cpu() - t0 <= 1000010, true);
+    sound_read(0x05A00000u, 2);
+    const uint32_t d1 = m68k_get_reg(nullptr, M68K_REG_D7);
+    // 1 ms of the 68000 (11 289.6 cycles) is 470 loops of 24 cycles
+    CHECK_EQ(d1 - d0 >= 469 && d1 - d0 <= 471, true);
+    g_master.budget = budget;
+    g_cpu = was;
+    sound_power(false);
+}
diff --git a/runtime/tests/vdp1_raster_test.cpp b/runtime/tests/vdp1_raster_test.cpp
new file mode 100644
index 0000000..fb24b1d
--- /dev/null
+++ b/runtime/tests/vdp1_raster_test.cpp
@@ -0,0 +1,84 @@
+// The native-framebuffer line walk (vdp1_raster.inc, line_native) against the general one it
+// stands in for: random command tables over random VRAM, drawn both ways, dot for dot.
+#include "test.h"
+#include "video.h"
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace {
+
+void be16(uint32_t a, uint16_t v) { g_vdp1_vram[a & 0x7FFFF] = (uint8_t)(v >> 8); g_vdp1_vram[(a + 1) & 0x7FFFF] = (uint8_t)v; }
+
+std::vector<uint16_t> draw(bool reference, uint16_t fbcr) {
+    vdp1_reference_raster(reference);
+    vdp1_reg_write(0x00, 0, 2);                          // TVMR: 16 bits a pixel
+    vdp1_reg_write(0x02, fbcr & 0x10, 2);                // FBCR: EOS for high speed shrink only
+    for (int i = 0; i < 512 * 256; ++i) vdp1_fb_write(i * 2, (uint32_t)(i * 2654435761u >> 16), 2);
+    vdp1_reg_write(0x04, 1, 2);                          // PTMR 1: draw now
+    std::vector<uint16_t> fb(512 * 256);
+    for (int i = 0; i < 512 * 256; ++i) fb[i] = (uint16_t)vdp1_fb_read(i * 2, 2);
+    vdp1_reference_raster(false);
+    return fb;
+}
+
+// A table of `n` random commands after system clipping, user clipping and local coordinates.
+void random_table(std::mt19937& rng, int n) {
+    auto r = [&](int lo, int hi) { return std::uniform_int_distribution<int>(lo, hi)(rng); };
+    // textures, colour tables and Gouraud tables: values biased toward 0 and the end codes
+    for (uint32_t a = 0x10000; a < 0x80000; a += 2) {
+        int k = r(0, 15);
+        uint16_t v = k == 0 ? 0 : k == 1 ? 0x7FFF : k == 2 ? 0xFFFF : k == 3 ? 0xF0F0 : (uint16_t)r(0, 0xFFFF);
+        be16(a, v);
+    }
+    uint32_t a = 0;
+    auto cmd = [&](uint16_t ctrl, uint16_t pmod, uint16_t colr, uint16_t srca, uint16_t size, const int* xy, uint16_t grda) {
+        be16(a, ctrl); be16(a + 2, 0); be16(a + 4, pmod); be16(a + 6, colr); be16(a + 8, srca); be16(a + 10, size);
+        for (int i = 0; i < 8; ++i) be16(a + 12 + i * 2, (uint16_t)xy[i]);
+        be16(a + 28, grda); be16(a + 30, 0);
+        a += 0x20;
+    };
+    int z[8] = {};
+    int sys[8] = {0, 0, 0, 0, r(100, 511), r(60, 255), 0, 0};
+    cmd(0x0009, 0, 0, 0, 0, sys, 0);
+    int user[8] = {r(0, 200), r(0, 120), 0, 0, r(100, 400), r(60, 250), 0, 0};
+    cmd(0x0008, 0, 0, 0, 0, user, 0);
+    int local[8] = {r(-30, 60), r(-30, 60), 0, 0, 0, 0, 0, 0};
+    cmd(0x000A, 0, 0, 0, 0, local, 0);
+    (void)z;
+    for (int i = 0; i < n; ++i) {
+        int comm = r(0, 7);
+        uint16_t ctrl = (uint16_t)(comm | (r(0, 3) << 4) | (comm == 1 ? r(0, 15) << 8 : 0));
+        int cmode = r(0, 5);
+        uint16_t pmod = (uint16_t)(r(0, 7) | cmode << 3 | r(0, 1) << 6 | r(0, 1) << 7 | (r(0, 3) == 0) << 8 |
+                                   r(0, 1) << 9 | r(0, 1) << 10 | (r(0, 7) == 0) << 15 | r(0, 1) << 12);
+        uint16_t colr = (uint16_t)(cmode == 1 ? (0x10000 + r(0, 0x1000) * 32) / 8 : r(0, 0xFFFF));
+        uint16_t srca = (uint16_t)((0x10000 + r(0, 0x6000) * 8) / 8);
+        uint16_t size = (uint16_t)(r(1, 8) << 8 | r(1, 64));
+        int xy[8];
+        for (int k = 0; k < 8; ++k) xy[k] = r(0, 9) == 0 ? r(-400, 900) : r(-40, 360);
+        if (comm == 1 && (ctrl >> 8 & 15)) { xy[2] = r(-20, 200); xy[3] = r(-20, 200); }
+        for (int& v : xy) v &= 0x1FFF;
+        cmd(ctrl, pmod, colr, srca, size, xy, (uint16_t)((0x10000 + r(0, 0x1000) * 8) / 8));
+    }
+    be16(a, 0x8000);                                     // END
+}
+
+}  // namespace
+
+TEST(native_line_walk_draws_as_the_general_one) {
+    std::mt19937 rng(20261025);
+    int differing = 0, drawn = 0;
+    for (int round = 0; round < 60; ++round) {
+        std::memset(g_vdp1_vram, 0, sizeof g_vdp1_vram);
+        random_table(rng, 40);
+        const uint16_t fbcr = (uint16_t)(round & 1 ? 0x10 : 0);
+        std::vector<uint16_t> fast = draw(false, fbcr), ref = draw(true, fbcr);
+        for (int i = 0; i < 512 * 256; ++i) {
+            differing += fast[i] != ref[i];
+            drawn += ref[i] != (uint16_t)(i * 2654435761u >> 16);
+        }
+    }
+    CHECK_EQ(differing, 0);
+    CHECK_EQ(drawn > 100000, true);
+}
diff --git a/runtime/tests/vdp1_replay.cpp b/runtime/tests/vdp1_replay.cpp
new file mode 100644
index 0000000..9985dee
--- /dev/null
+++ b/runtime/tests/vdp1_replay.cpp
@@ -0,0 +1,36 @@
+// VDP1 replay: draws a VRAM snapshot's command list with the runtime's own rasterizer, outside any
+// game, so a reference framebuffer for the same VRAM can be compared dot for dot (no game timing).
+//   vdp1_replay VRAM.bin OUT.bin TVMR FBCR EWDR EWLR EWRR      (registers in hex)
+// VRAM.bin: the 512 KiB of VDP1 VRAM, big-endian as the bus sees it. OUT.bin: the 512x256 16-bit
+// draw framebuffer, big-endian. The erase window is filled with EWDR first, the rest with 0.
+#include "../src/video/video.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+int main(int argc, char** argv) {
+    if (argc < 8) { std::fprintf(stderr, "usage: vdp1_replay VRAM.bin OUT.bin TVMR FBCR EWDR EWLR EWRR\n"); return 2; }
+    FILE* f = std::fopen(argv[1], "rb");
+    if (!f || std::fread(g_vdp1_vram, 1, sizeof g_vdp1_vram, f) != sizeof g_vdp1_vram) { std::fprintf(stderr, "bad VRAM file\n"); return 1; }
+    std::fclose(f);
+    unsigned r[5];
+    for (int i = 0; i < 5; ++i) r[i] = (unsigned)std::strtoul(argv[3 + i], nullptr, 16) & 0xFFFF;
+    vdp1_init();
+    vdp1_reg_write(0x00, r[0], 2);                       // TVMR
+    vdp1_reg_write(0x02, r[1] & ~3u, 2);                 // FBCR, no frame change or erase request
+    vdp1_reg_write(0x06, r[2], 2); vdp1_reg_write(0x08, r[3], 2); vdp1_reg_write(0x0A, r[4], 2);
+    for (int i = 0; i < 512 * 256; ++i) vdp1_fb_write(i * 2, 0, 2);
+    int x0 = (r[3] >> 9 & 0x7F) * 8, y0 = r[3] & 0x1FF, x1 = (r[4] >> 9 & 0x7F) * 8, y1 = r[4] & 0x1FF;
+    for (int y = y0; y <= y1 && y < 256; ++y)
+        for (int x = x0; x < x1 && x < 512; ++x) vdp1_fb_write((y * 512 + x) * 2, r[2], 2);
+    vdp1_reg_write(0x04, 1, 2);                          // PTMR 1: draw now
+    FILE* o = std::fopen(argv[2], "wb");
+    if (!o) return 1;
+    for (int i = 0; i < 512 * 256; ++i) {
+        uint16_t v = (uint16_t)vdp1_fb_read(i * 2, 2);
+        uint8_t b[2] = {(uint8_t)(v >> 8), (uint8_t)v};
+        std::fwrite(b, 1, 2, o);
+    }
+    std::fclose(o);
+    return 0;
+}
diff --git a/runtime/tests/vdp1_steps_test.cpp b/runtime/tests/vdp1_steps_test.cpp
new file mode 100644
index 0000000..472e126
--- /dev/null
+++ b/runtime/tests/vdp1_steps_test.cpp
@@ -0,0 +1,137 @@
+// VDP1's step arithmetic (vdp1_steps.h) against the rules of Sega's VDP1 User's Manual.
+#include "../src/video/vdp1_steps.h"
+#include "test.h"
+
+using namespace vdp1_steps;
+
+// Figure 1.6: x and y stepping the same way put the extra dot at (new x, old y).
+TEST(aa_corner_same_direction_is_new_x_old_y) {
+    auto a = aa_corner(10, 20, 1, 1);  CHECK_EQ(a.x, 11); CHECK_EQ(a.y, 20);
+    auto b = aa_corner(10, 20, -1, -1); CHECK_EQ(b.x, 9); CHECK_EQ(b.y, 20);
+}
+// Figure 1.6: opposite directions put it at (old x, new y).
+TEST(aa_corner_opposite_direction_is_old_x_new_y) {
+    auto a = aa_corner(10, 20, 1, -1);  CHECK_EQ(a.x, 10); CHECK_EQ(a.y, 19);
+    auto b = aa_corner(10, 20, -1, 1);  CHECK_EQ(b.x, 10); CHECK_EQ(b.y, 21);
+}
+TEST(mesh_draws_dots_with_equal_low_bits) {
+    CHECK_EQ(mesh_drawn(0, 0), true);  CHECK_EQ(mesh_drawn(1, 1), true);
+    CHECK_EQ(mesh_drawn(1, 0), false); CHECK_EQ(mesh_drawn(0, 3), false);
+    CHECK_EQ(mesh_drawn(-2, 4), true);
+}
+TEST(end_code_stops_the_line_at_the_second_read) {
+    EndCodes e;
+    CHECK_EQ(e.read(false, true), true);
+    CHECK_EQ(e.read(true, true), true);   // first end code: transparent, line goes on
+    CHECK_EQ(e.read(true, false), true);  // the same texel again (enlarged): not a new read
+    CHECK_EQ(e.read(false, true), true);
+    CHECK_EQ(e.read(true, true), false);  // second end code: stop
+    CHECK_EQ(e.read(false, true), false);
+}
+// Texture columns map the character's first and last columns on the line's ends.
+TEST(column_maps_corners_to_ends) {
+    CHECK_EQ(column(0, 16, 15), 0);
+    CHECK_EQ(column(15, 16, 15), 15);
+    for (int k = 0; k < 16; ++k) CHECK_EQ(column(k, 16, 15), k);   // 1:1 is the identity
+    CHECK_EQ(column(31, 16, 31), 15);                              // enlarged x2
+    CHECK_EQ(column(7, 16, 7), 15);                                // reduced to 8 dots
+    CHECK_EQ(column(0, 16, 7), 1);                                 // its dots' centres
+    CHECK_EQ(column(0, 8, 0), 4);                                  // one dot: the middle
+}
+// A flipped character is sampled as the unflipped one turned around (drawing order returned).
+TEST(flipped_columns_mirror_the_unflipped_sampling) {
+    for (int len = 0; len < 40; ++len)
+        for (int w = 1; w <= 33; ++w)
+            for (int k = 0; k <= len; ++k)
+                CHECK_EQ(column(k, w, len, true), w - 1 - column(len - k, w, len));
+    for (int k = 0; k < 16; ++k) CHECK_EQ(column(k, 16, 15, true), k);   // 1:1 still the identity
+    CHECK_EQ(column(0, 8, 0, true), 3);                                   // one dot: the other middle
+    // the flipped 48 -> 45 shrink: centres on texel boundaries go toward the first texel
+    CHECK_EQ(column(7, 48, 44), 8); CHECK_EQ(column(7, 48, 44, true), 7);
+}
+TEST(exact_halves_round_down_unflipped_and_up_flipped) {
+    // 3 texels over 5 dots: k*(2)/4 has halves at k=1 and k=3
+    CHECK_EQ(column(1, 3, 4), 0); CHECK_EQ(column(3, 3, 4), 1);
+    CHECK_EQ(column(1, 3, 4, true), 1); CHECK_EQ(column(3, 3, 4, true), 2);
+    CHECK_EQ(row(1, 3, 4), 0);    CHECK_EQ(row(3, 3, 4), 1);
+    CHECK_EQ(row(4, 3, 4), 2);
+    CHECK_EQ(row(1, 32, 5), 3 * 32 / 12); CHECK_EQ(row(1, 32, 5, true), 7);   // shrink: 8 -> 7 flipped
+}
+TEST(edge_walk_hits_both_vertices_and_rounds_halves_down) {
+    CHECK_EQ(edge(5, 9, 0, 4), 5); CHECK_EQ(edge(5, 9, 4, 4), 9);
+    CHECK_EQ(edge(0, 1, 1, 2), 0);   // 0.5 -> 0
+    CHECK_EQ(edge(0, -1, 1, 2), -1); // -0.5 -> -1
+    CHECK_EQ(edge(0, 3, 1, 2), 1);   // 1.5 -> 1
+    CHECK_EQ(edge(7, 7, 3, 0), 7);
+}
+TEST(gouraud_steps_like_a_texture) {
+    // 32 values over 5 dots: more values than dots, so the centres (2k + 1) * 32 / 10
+    CHECK_EQ(shade(0, 31, 0, 4), 3);  CHECK_EQ(shade(0, 31, 1, 4), 9);
+    CHECK_EQ(shade(0, 31, 3, 4), 22); CHECK_EQ(shade(0, 31, 4, 4), 28);
+    // a falling run is the rising one turned around
+    for (int k = 0; k <= 4; ++k) CHECK_EQ(shade(31, 0, k, 4), shade(0, 31, 4 - k, 4));
+    // fewer values than dots: corner to corner, halves down
+    CHECK_EQ(shade(16, 18, 0, 8), 16); CHECK_EQ(shade(16, 18, 8, 8), 18);
+    CHECK_EQ(shade(16, 18, 2, 8), 16); CHECK_EQ(shade(16, 18, 6, 8), 17);
+    CHECK_EQ(shade(7, 7, 3, 9), 7);
+}
+TEST(quad_sides_step_over_their_own_length) {
+    // a side of 4 dots walked in 5 steps: ends on both vertices, 2.4 -> 2
+    CHECK_EQ(side_step(0, 4, 5, 4), 0); CHECK_EQ(side_step(5, 4, 5, 4), 4);
+    CHECK_EQ(side_step(3, 4, 5, 4), 2);
+    // an exact half goes toward the smaller major coordinate: 52 dots in 56 steps, step 7 is 6.5
+    CHECK_EQ(side_step(7, 52, 56, 52), 6);   // rising side: down
+    CHECK_EQ(side_step(7, 52, 56, -52), 7);  // falling side: up, i.e. further toward the minus end
+    CHECK_EQ(side_point(-5, -4, 6, 52), -5); CHECK_EQ(side_point(-107, -55, 6, 52), -101);
+    CHECK_EQ(side_point(10, -42, 7, 52), 3);
+    CHECK_EQ(side_step(0, 0, 9, 0), 0);
+}
+
+// High speed shrink steps over column pairs and takes one parity of the stored character.
+TEST(high_speed_shrink_samples_one_parity_of_stored_columns) {
+    for (int len = 0; len < 15; ++len)
+        for (int k = 0; k <= len; ++k) {
+            CHECK_EQ(hss_column(k, 16, len, false, 0) % 2, 0);
+            CHECK_EQ(hss_column(k, 16, len, false, 1) % 2, 1);
+            // flipped: the stored column (15 - drawn) keeps the parity
+            CHECK_EQ((15 - hss_column(k, 16, len, true, 0)) % 2, 0);
+            CHECK_EQ((15 - hss_column(k, 16, len, true, 1)) % 2, 1);
+        }
+    // 48 wide on 32 dots (the church wall): 24 pairs enlarged onto 32 dots, every pair used
+    bool used[24] = {};
+    for (int k = 0; k < 32; ++k) used[hss_column(k, 48, 31, false, 0) / 2] = true;
+    for (bool u : used) CHECK_EQ(u, true);
+    // 48 wide on 8 dots: pairs sampled at the dots' centres, (2k + 1) * 24 / 16
+    CHECK_EQ(hss_column(0, 48, 7, false, 0), 2);
+    CHECK_EQ(hss_column(7, 48, 7, false, 1), 2 * 22 + 1);
+    // a flipped 16-wide character on 4 dots, eos 0: the 8 pairs shrink onto 4 dots at centres
+    // 1,3,5,7 counted from the flipped end, i.e. stored pairs 7,5,3,1 (columns 14,10,6,2),
+    // which the flip draws at 1,5,9,13
+    CHECK_EQ(hss_column(0, 16, 3, true, 0), 1);
+    CHECK_EQ(hss_column(1, 16, 3, true, 0), 5);
+    CHECK_EQ(hss_column(3, 16, 3, true, 0), 13);
+    CHECK_EQ(hss_column(0, 15, 3, false, 1), 1);
+    CHECK_EQ(hss_column(5, 1, 3, false, 1), 0);   // no pair: column 0
+}
+// Shrinking samples under the dot's centre; enlarging maps corner to corner.
+TEST(shrink_samples_at_dot_centres) {
+    for (int q = 0; q < 8; ++q) CHECK_EQ(shrink_sample(q, 16, 7), 2 * q + 1);
+    CHECK_EQ(shrink_sample(0, 48, 31), 0);  CHECK_EQ(shrink_sample(31, 48, 31), 47);
+    CHECK_EQ(shrink_sample(1, 48, 31), 2);  // 1.5 * 48 / 32 = 2.25
+    CHECK_EQ(shrink_sample(0, 5, 0), 2);    // one dot: the middle texel
+    CHECK_EQ(column(3, 16, 7), 7);          // shrunk columns sample centres
+    CHECK_EQ(row(3, 16, 7), 7);             // and so do rows
+    CHECK_EQ(row(1, 3, 4), 0);              // enlarged rows: corner to corner, halves down
+    CHECK_EQ(row(1, 3, 4, true), 1);        // a vertically flipped one rounds halves up
+    CHECK_EQ(row(3, 3, 4, true), 2);
+    CHECK_EQ(row(2, 3, 4, true), 1);
+    CHECK_EQ(row(3, 16, 7, true), 6);       // shrunk rows mirror too: a centre on a boundary goes up
+    CHECK_EQ(column(1, 3, 4), 0);           // enlarged columns: halves down too
+}
+// An anti-aliasing dot takes the next step's texel and colour, never past the line's end.
+TEST(aa_dot_takes_the_next_step) {
+    CHECK_EQ(aa_step(0, 5), 1);
+    CHECK_EQ(aa_step(4, 5), 5);
+    CHECK_EQ(aa_step(5, 5), 5);
+    CHECK_EQ(aa_step(0, 0), 0);
+}
diff --git a/runtime/tests/vdp2_replay.cpp b/runtime/tests/vdp2_replay.cpp
new file mode 100644
index 0000000..3a25230
--- /dev/null
+++ b/runtime/tests/vdp2_replay.cpp
@@ -0,0 +1,42 @@
+// VDP2 replay: composes one field from a snapshot of VDP2 VRAM, colour RAM and registers with the
+// sprite layer taken from a given VDP1 framebuffer, outside any game, so a reference picture of
+// the same state can be compared dot for dot (no game timing).
+//   vdp2_replay STATE.bin OUT.bin
+// STATE.bin, all 16-bit words big-endian as the bus sees them: VDP2 VRAM (512 KiB), colour RAM
+// (4 KiB), registers (512 bytes), the VDP1 framebuffer shown (512x256 words), then TVMR and FBCR
+// (one word each). OUT.bin: width and height (u32 little-endian), then 0x00RRGGBB per dot (u32
+// little-endian), top row first.
+#include "../src/video/video.h"
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+int main(int argc, char** argv) {
+    if (argc < 3) { std::fprintf(stderr, "usage: vdp2_replay STATE.bin OUT.bin\n"); return 2; }
+    const size_t fb_bytes = 512 * 256 * 2, n = sizeof g_vdp2_vram + sizeof g_vdp2_cram + sizeof g_vdp2_regs + fb_bytes + 4;
+    std::vector<uint8_t> in(n);
+    FILE* f = std::fopen(argv[1], "rb");
+    if (!f || std::fread(in.data(), 1, n, f) != n) { std::fprintf(stderr, "bad state file\n"); return 1; }
+    std::fclose(f);
+    const uint8_t* p = in.data();
+    std::memcpy(g_vdp2_vram, p, sizeof g_vdp2_vram); p += sizeof g_vdp2_vram;
+    std::memcpy(g_vdp2_cram, p, sizeof g_vdp2_cram); p += sizeof g_vdp2_cram;
+    std::memcpy(g_vdp2_regs, p, sizeof g_vdp2_regs); p += sizeof g_vdp2_regs;
+    const uint8_t* fb = p; p += fb_bytes;
+    const unsigned tvmr = p[0] << 8 | p[1], fbcr = p[2] << 8 | p[3];
+    vdp1_init();
+    vdp1_reg_write(0x00, tvmr, 2);
+    vdp1_reg_write(0x02, 0, 2);                         // one-cycle mode: the next VBlank-OUT swaps
+    for (int i = 0; i < 512 * 256; ++i) vdp1_fb_write(i * 2, fb[2 * i] << 8 | fb[2 * i + 1], 2);
+    vdp1_vblank_out();                                  // ... so the framebuffer written is shown
+    vdp1_reg_write(0x02, fbcr & ~3u, 2);
+    Frame out;
+    vdp2_compose(out);
+    FILE* o = std::fopen(argv[2], "wb");
+    if (!o) return 1;
+    uint32_t wh[2] = {(uint32_t)out.w, (uint32_t)out.h};
+    std::fwrite(wh, 4, 2, o);
+    std::fwrite(out.px.data(), 4, out.px.size(), o);
+    std::fclose(o);
+    return 0;
+}
