@@ -0,0 +1,49 @@
+// saturn-recomp runtime — the return addresses of the calls in flight, so a return can skip frames.
+//
+// Recompiled code keeps the SH-2 call chain on the host stack, and each call checks that its callee came
+// back to the instruction after it. Some code returns further out than its caller: a shared epilogue
+// entered in the middle of a function pops a frame its own caller never pushed (an `add #n,r15;
+// lds.l @r15+,pr; rts` reached by a jsr), and the rts lands on a return address an outer call is
+// waiting for. The SH-2 just goes on there. Here the frame that waits for that address is found among
+// the calls in flight and the host stack unwinds to it (SH2ReturnTo), which then goes on as if its
+// callee had returned normally.
+//
+// Each host stack (the master's, each task fiber's) has its own list. A barrier (an interrupt's entry)
+// ends the search: a handler cannot return into the code it interrupted that way.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+struct SH2ReturnTo { uint32_t pc; size_t depth; };
+
+class SH2CallFrames {
+public:
+    static constexpr uint32_t kBarrier = 0xFFFFFFFFu;
+    size_t push(uint32_t ret) { v_.push_back(ret); return v_.size() - 1; }
+    void pop(size_t depth) { if (v_.size() > depth) v_.resize(depth); }
+    void clear() { v_.clear(); }
+    size_t size() const { return v_.size(); }
+    // The innermost call in flight that returns to pc, above the innermost barrier; -1 if none.
+    long find(uint32_t pc) const {
+        if (pc == kBarrier) return -1;
+        for (size_t i = v_.size(); i-- > 0;) {
+            if (v_[i] == kBarrier) return -1;
+            if (v_[i] == pc) return (long)i;
+        }
+        return -1;
+    }
+private:
+    std::vector<uint32_t> v_;
+};
+
+// The list of the host stack that runs now (tasks.cpp switches it with the fiber).
+extern SH2CallFrames* g_sh2_frames;
+extern SH2CallFrames g_sh2_master_frames;   // the master's own host stack
+
+// Pushes a call (or a barrier) for the scope.
+struct SH2CallFrame {
+    size_t depth;
+    explicit SH2CallFrame(uint32_t ret) : depth(g_sh2_frames->push(ret)) {}
+    ~SH2CallFrame() { g_sh2_frames->pop(depth); }
+};
